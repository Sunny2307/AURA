# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release signing — real secrets, never commit these.
# `android/key.properties` holds the keystore passwords, and losing the .jks
# itself means never being able to update the app on Play again, so keep a
# backup somewhere outside the repo.
/android/key.properties
*.jks
*.keystore

# iOS signing
*.p12
*.mobileprovision
*.cer

# Environment / service credentials
.env
.env.*
!.env.example
node_modules/
.npm-cache/
.local-appdata/
**/serviceAccountKey.json
**/*-firebase-adminsdk-*.json

# Note: google-services.json and GoogleService-Info.plist are deliberately NOT
# ignored. They ship inside the app binary and are not secrets — Firebase access
# is controlled by security rules, not by hiding these files. The build needs
# them present.
